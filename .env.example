# Configuración de Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Certificados AFIP / ARCA de la Plataforma
# ATENCIÓN: PLATFORM_AFIP_CERT y PLATFORM_AFIP_KEY corresponden al certificado y clave privada ÚNICOS
# de la plataforma (empresa administradora), generados una sola vez con el CUIT de la empresa.
# No son por tenant. Los tenants delegan el servicio AFIP al CUIT de la plataforma.
# Los valores pueden ser texto PEM directo o en formato Base64.
PLATFORM_AFIP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PLATFORM_AFIP_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# @afipsdk/afip.js v1.x reenvía todas las llamadas (incluida la firma del TRA)
# a la nube de AfipSDK y exige este token en cada instancia de Afip(), aunque
# se use certificado propio. Sin él, devuelve 401 antes de hablar con AFIP.
# Se obtiene creando una cuenta en https://app.afipsdk.com/ (es único de la
# plataforma, igual que PLATFORM_AFIP_CERT/KEY, no es por tenant).
AFIPSDK_ACCESS_TOKEN=your-afipsdk-access-token

# CUIT por defecto / plataforma (opcional fallback)
AFIP_CUIT=20000000000
AFIP_PUNTO_DE_VENTA=1
AFIP_ENV=development

# Puerto del servidor Express
PORT=3001
