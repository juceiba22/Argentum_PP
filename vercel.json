{
  "rewrites": [
    {
      "source": "/api/mercadopago/:path*",
      "destination": "/api/mercadopago/index.js"
    },
    {
      "source": "/api/licencias/:path*",
      "destination": "/api/licencias/index.js"
    },
    {
      "source": "/api/equipo/:path*",
      "destination": "/api/equipo/index.js"
    },
    {
      "source": "/api/arca/:path*",
      "destination": "/api/arca/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
